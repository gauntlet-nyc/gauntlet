{
  "$defs": {
    "Attribution": {
      "enum": [
        "introduced",
        "pre_existing",
        "unknown"
      ],
      "title": "Attribution",
      "type": "string"
    },
    "GateStatus": {
      "enum": [
        "confirmed_regression",
        "confirmed_pre_existing",
        "confirmed_policy_violation",
        "suspected",
        "not_reproducible",
        "environment_error",
        "passed",
        "not_tested"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attack_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Attack Id",
      "type": "string"
    },
    "attribution": {
      "$ref": "#/$defs/Attribution"
    },
    "base_attempts": {
      "minimum": 0,
      "title": "Base Attempts",
      "type": "integer"
    },
    "base_reproductions": {
      "minimum": 0,
      "title": "Base Reproductions",
      "type": "integer"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Finding Id",
      "type": "string"
    },
    "head_attempts": {
      "minimum": 0,
      "title": "Head Attempts",
      "type": "integer"
    },
    "head_reproductions": {
      "minimum": 0,
      "title": "Head Reproductions",
      "type": "integer"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 2500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "oracle_ids": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Oracle Ids",
      "type": "array"
    },
    "oracle_verdict_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Oracle Verdict Ids",
      "type": "array"
    },
    "repro_manifest_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repro Manifest Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/GateStatus"
    },
    "trace_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Trace Ids",
      "type": "array"
    }
  },
  "required": [
    "finding_id",
    "attack_id",
    "status",
    "attribution",
    "severity",
    "oracle_ids",
    "head_reproductions",
    "head_attempts",
    "base_reproductions",
    "base_attempts"
  ],
  "title": "Finding",
  "type": "object"
}
