{
  "$defs": {
    "MissingInput": {
      "additionalProperties": false,
      "description": "A replay/historical input that was not recorded, and why. Missing never means safe.",
      "properties": {
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "maxLength": 2500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "field",
        "reason",
        "critical"
      ],
      "title": "MissingInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Id"
    },
    "excluded_source_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excluded Source Id"
    },
    "fixture_checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Checksum",
      "type": "string"
    },
    "fixture_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Fixture Id",
      "type": "string"
    },
    "image_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Digest"
    },
    "input_messages_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Messages Hash"
    },
    "kb_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kb Snapshot Hash"
    },
    "logical_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logical Timestamp"
    },
    "max_runtime_seconds": {
      "default": 180,
      "maximum": 1800,
      "minimum": 1,
      "title": "Max Runtime Seconds",
      "type": "integer"
    },
    "memory_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Snapshot Hash"
    },
    "missing_inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MissingInput"
      },
      "title": "Missing Inputs",
      "type": "array"
    },
    "mode": {
      "enum": [
        "gate_compare",
        "historical_control",
        "historical_counterfactual",
        "fix_regression",
        "event_audit"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "mutation_description": {
      "anyOf": [
        {
          "maxLength": 2500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mutation Description"
    },
    "policy_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Version"
    },
    "prompt_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "replacement_source_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement Source Id"
    },
    "replay_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Replay Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "source_sha": {
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Source Sha",
      "type": "string"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Target Id",
      "type": "string"
    },
    "tool_results_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Results Hash"
    },
    "tool_schema_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Schema Hash"
    }
  },
  "required": [
    "replay_id",
    "mode",
    "target_id",
    "source_sha",
    "fixture_id",
    "fixture_checksum"
  ],
  "title": "ReplaySpec",
  "type": "object"
}
