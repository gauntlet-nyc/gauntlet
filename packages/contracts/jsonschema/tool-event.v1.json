{
  "additionalProperties": false,
  "description": "One recorded tool operation. `outcome='unknown'` is never treated as success or failure.",
  "properties": {
    "actor_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Actor Ref",
      "type": "string"
    },
    "arguments_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Arguments Hash",
      "type": "string"
    },
    "decision_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Id"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "result_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Hash"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "side_effect_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Side Effect Ids",
      "type": "array"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Target Id",
      "type": "string"
    },
    "tool_name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "target_id",
    "tool_name",
    "actor_ref",
    "arguments_hash",
    "occurred_at",
    "outcome"
  ],
  "title": "ToolEvent",
  "type": "object"
}
