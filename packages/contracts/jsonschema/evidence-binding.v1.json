{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "created_at"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSubject": {
      "additionalProperties": false,
      "description": "What the evidence is about. Supplied by the trusted collector at capture time.",
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Attempt Id",
          "type": "string"
        },
        "collector": {
          "enum": [
            "browser_collector",
            "api_collector",
            "replay_collector"
          ],
          "title": "Collector",
          "type": "string"
        },
        "environment_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "fixture_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fixture Checksum",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Observation Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{7,64}$",
          "title": "Source Sha",
          "type": "string"
        },
        "step_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Index"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "observation_id",
        "environment_id",
        "source_sha",
        "fixture_checksum",
        "collector"
      ],
      "title": "EvidenceSubject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Written once by the artifact store; the verifier re-checks it against stored bytes.",
  "properties": {
    "byte_size": {
      "maximum": 52428800,
      "minimum": 1,
      "title": "Byte Size",
      "type": "integer"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceRef"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/EvidenceSubject"
    }
  },
  "required": [
    "evidence",
    "subject",
    "byte_size",
    "recorded_at"
  ],
  "title": "EvidenceBinding",
  "type": "object"
}
