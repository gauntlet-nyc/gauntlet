{
  "$defs": {
    "MemoryProvenance": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{7,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "finding_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "oracle_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oracle Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        }
      },
      "title": "MemoryProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fact_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Fact Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "ui_occlusion",
        "authz_bypass",
        "workflow_state",
        "policy_conflict",
        "fix_pattern"
      ],
      "title": "Kind",
      "type": "string"
    },
    "known_at": {
      "format": "date-time",
      "title": "Known At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_/.-]*$",
      "title": "Scope",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/MemoryProvenance"
    },
    "summary": {
      "maxLength": 2500,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "surface_kinds": {
      "items": {
        "enum": [
          "route",
          "component",
          "api",
          "agent_tool",
          "style",
          "workflow"
        ],
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Surface Kinds",
      "type": "array"
    },
    "trust": {
      "enum": [
        "verified_test",
        "policy",
        "app_content",
        "model_summary"
      ],
      "title": "Trust",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "verification": {
      "enum": [
        "confirmed",
        "unverified"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "required": [
    "fact_id",
    "kind",
    "summary",
    "verification",
    "trust",
    "scope",
    "surface_kinds",
    "source",
    "known_at",
    "valid_from"
  ],
  "title": "TemporalMemoryFact",
  "type": "object"
}
