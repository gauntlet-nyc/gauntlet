{
  "$defs": {
    "RecallClassification": {
      "enum": [
        "audit_violation",
        "audit_clear",
        "tainted",
        "cleared",
        "inconclusive",
        "not_replayable"
      ],
      "title": "RecallClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classification": {
      "$ref": "#/$defs/RecallClassification"
    },
    "control_matches": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Matches"
    },
    "criterion_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Criterion Version",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 2500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "material_change": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material Change"
    },
    "mode": {
      "enum": [
        "event_audit",
        "decision_counterfactual"
      ],
      "title": "Mode",
      "type": "string"
    },
    "rationale": {
      "maxLength": 2500,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "recall_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Recall Id",
      "type": "string"
    },
    "replay_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Replay Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Verdict Id",
      "type": "string"
    }
  },
  "required": [
    "verdict_id",
    "recall_id",
    "decision_id",
    "mode",
    "classification",
    "rationale",
    "criterion_version"
  ],
  "title": "RecallVerdict",
  "type": "object"
}
