{
  "$defs": {
    "BriefFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Finding Id",
          "type": "string"
        },
        "headline": {
          "maxLength": 2500,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        }
      },
      "required": [
        "finding_id",
        "status",
        "severity",
        "headline"
      ],
      "title": "BriefFinding",
      "type": "object"
    },
    "GateStatus": {
      "enum": [
        "confirmed_regression",
        "confirmed_pre_existing",
        "confirmed_policy_violation",
        "suspected",
        "not_reproducible",
        "environment_error",
        "passed",
        "not_tested"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Built only from persisted findings; `source_event_sequence` ties it to the event log.",
  "properties": {
    "confirmed": {
      "minimum": 0,
      "title": "Confirmed",
      "type": "integer"
    },
    "coverage_gaps": {
      "minimum": 0,
      "title": "Coverage Gaps",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/BriefFinding"
      },
      "maxItems": 20,
      "title": "Findings",
      "type": "array"
    },
    "not_tested": {
      "minimum": 0,
      "title": "Not Tested",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_event_sequence": {
      "minimum": 0,
      "title": "Source Event Sequence",
      "type": "integer"
    },
    "spoken_summary": {
      "maxLength": 2500,
      "minLength": 1,
      "title": "Spoken Summary",
      "type": "string"
    },
    "suspected": {
      "minimum": 0,
      "title": "Suspected",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "source_event_sequence",
    "findings",
    "confirmed",
    "suspected",
    "not_tested",
    "coverage_gaps",
    "spoken_summary"
  ],
  "title": "VoiceBriefing",
  "type": "object"
}
