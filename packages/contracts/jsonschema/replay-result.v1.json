{
  "$defs": {
    "ReplayStatus": {
      "enum": [
        "matched",
        "different",
        "inconclusive",
        "not_replayable",
        "environment_error"
      ],
      "title": "ReplayStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amount_minor": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount Minor"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 2500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "observed_action": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Action"
    },
    "replay_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Replay Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_hash_after": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State Hash After"
    },
    "state_hash_before": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "State Hash Before"
    },
    "status": {
      "$ref": "#/$defs/ReplayStatus"
    },
    "trace_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Trace Ids",
      "type": "array"
    }
  },
  "required": [
    "replay_id",
    "status"
  ],
  "title": "ReplayResult",
  "type": "object"
}
