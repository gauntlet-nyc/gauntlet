{
  "$defs": {
    "ApiRequestStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "test_api",
          "default": "test_api",
          "title": "Action",
          "type": "string"
        },
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "body_json": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Json"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "method",
        "path",
        "actor_id"
      ],
      "title": "ApiRequestStep",
      "type": "object"
    },
    "CaptureStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "capture",
          "default": "capture",
          "title": "Action",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "CaptureStep",
      "type": "object"
    },
    "ChatStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "chat",
          "default": "chat",
          "title": "Action",
          "type": "string"
        },
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Agent Id",
          "type": "string"
        },
        "message": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "actor_id",
        "message"
      ],
      "title": "ChatStep",
      "type": "object"
    },
    "ClickStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "click",
          "default": "click",
          "title": "Action",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "ClickStep",
      "type": "object"
    },
    "InspectStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "inspect",
          "default": "inspect",
          "title": "Action",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "InspectStep",
      "type": "object"
    },
    "NavigateStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "navigate",
          "default": "navigate",
          "title": "Action",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "NavigateStep",
      "type": "object"
    },
    "PressStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "press",
          "default": "press",
          "title": "Action",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9+]{1,32}$",
          "title": "Key",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "PressStep",
      "type": "object"
    },
    "ResizeStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "resize",
          "default": "resize",
          "title": "Action",
          "type": "string"
        },
        "height": {
          "maximum": 2160,
          "minimum": 240,
          "title": "Height",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "width": {
          "maximum": 3840,
          "minimum": 240,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "ResizeStep",
      "type": "object"
    },
    "ScrollStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "scroll",
          "default": "scroll",
          "title": "Action",
          "type": "string"
        },
        "delta_y": {
          "maximum": 20000,
          "minimum": -20000,
          "title": "Delta Y",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "delta_y"
      ],
      "title": "ScrollStep",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{7,64}$",
          "title": "Sha",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha",
        "start_line",
        "end_line"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TypeStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "type",
          "default": "type",
          "title": "Action",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "value": {
          "maxLength": 5000,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "target",
        "value"
      ],
      "title": "TypeStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attack_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Attack Id",
      "type": "string"
    },
    "expected_observation": {
      "maxLength": 2500,
      "minLength": 1,
      "title": "Expected Observation",
      "type": "string"
    },
    "fixture_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Fixture Id",
      "type": "string"
    },
    "hypothesis": {
      "maxLength": 2500,
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
    },
    "max_actions": {
      "maximum": 100,
      "minimum": 1,
      "title": "Max Actions",
      "type": "integer"
    },
    "max_runtime_seconds": {
      "maximum": 900,
      "minimum": 1,
      "title": "Max Runtime Seconds",
      "type": "integer"
    },
    "oracle_ids": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Oracle Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "capture": "#/$defs/CaptureStep",
            "chat": "#/$defs/ChatStep",
            "click": "#/$defs/ClickStep",
            "inspect": "#/$defs/InspectStep",
            "navigate": "#/$defs/NavigateStep",
            "press": "#/$defs/PressStep",
            "resize": "#/$defs/ResizeStep",
            "scroll": "#/$defs/ScrollStep",
            "test_api": "#/$defs/ApiRequestStep",
            "type": "#/$defs/TypeStep"
          },
          "propertyName": "action"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NavigateStep"
          },
          {
            "$ref": "#/$defs/ResizeStep"
          },
          {
            "$ref": "#/$defs/ClickStep"
          },
          {
            "$ref": "#/$defs/ScrollStep"
          },
          {
            "$ref": "#/$defs/TypeStep"
          },
          {
            "$ref": "#/$defs/PressStep"
          },
          {
            "$ref": "#/$defs/InspectStep"
          },
          {
            "$ref": "#/$defs/CaptureStep"
          },
          {
            "$ref": "#/$defs/ApiRequestStep"
          },
          {
            "$ref": "#/$defs/ChatStep"
          }
        ]
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Target Id",
      "type": "string"
    },
    "why_this_change": {
      "maxLength": 2500,
      "minLength": 1,
      "title": "Why This Change",
      "type": "string"
    },
    "worker_kind": {
      "enum": [
        "ui",
        "accessibility",
        "workflow",
        "api",
        "concurrency",
        "ai_agent"
      ],
      "title": "Worker Kind",
      "type": "string"
    }
  },
  "required": [
    "attack_id",
    "hypothesis",
    "why_this_change",
    "expected_observation",
    "source_refs",
    "worker_kind",
    "target_id",
    "fixture_id",
    "steps",
    "oracle_ids",
    "max_actions",
    "max_runtime_seconds"
  ],
  "title": "AttackSpec",
  "type": "object"
}
