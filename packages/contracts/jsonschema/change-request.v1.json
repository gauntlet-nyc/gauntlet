      "type": "string"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Head Sha",
      "type": "string"
    },
    "max_cost_usd_cents": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Cost Usd Cents",
      "type": "integer"
    },
    "repository_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Repository Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Target Id",
      "type": "string"
