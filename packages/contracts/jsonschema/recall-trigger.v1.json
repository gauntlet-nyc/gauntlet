{
  "additionalProperties": false,
  "properties": {
    "end_at": {
      "format": "date-time",
      "title": "End At",
      "type": "string"
    },
    "kind": {
      "enum": [
        "finding",
        "document",
        "memory",
        "model_version",
        "prompt_version",
        "policy_version",
        "tool_result_window"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mode": {
      "enum": [
        "event_audit",
        "decision_counterfactual"
