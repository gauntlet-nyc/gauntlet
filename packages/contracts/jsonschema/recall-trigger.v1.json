    "reference": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reference",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
