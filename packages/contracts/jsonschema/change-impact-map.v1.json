{
  "$defs": {
    "AffectedSurface": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "identifier": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "kind": {
          "enum": [
            "route",
            "component",
            "api",
            "agent_tool",
            "style",
            "workflow"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChangeSignal"
          },
          "maxItems": 20,
          "title": "Signals",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "identifier",
        "source_refs",
        "confidence"
      ],
      "title": "AffectedSurface",
      "type": "object"
    },
    "ChangeSignal": {
      "additionalProperties": false,
      "description": "A deterministic, line-cited hint about *what kind* of change this is. Never a verdict.",
      "properties": {
        "excerpt": {
          "maxLength": 300,
          "title": "Excerpt",
          "type": "string"
        },
        "kind": {
          "enum": [
            "auth_check_removed",
            "auth_check_added",
            "side_effect_call",
            "tool_definition",
            "layout_positioning"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "required": [
        "kind",
        "source_ref",
        "excerpt"
      ],
      "title": "ChangeSignal",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{7,64}$",
          "title": "Sha",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha",
        "start_line",
        "end_line"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_sha": {
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Base Sha",
      "type": "string"
    },
    "changed_files": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Changed Files",
      "type": "array"
    },
    "coverage_gaps": {
      "default": [],
      "items": {
        "maxLength": 2500,
        "minLength": 1,
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Head Sha",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "surfaces": {
      "items": {
        "$ref": "#/$defs/AffectedSurface"
      },
      "maxItems": 100,
      "title": "Surfaces",
      "type": "array"
    }
  },
  "required": [
    "base_sha",
    "head_sha",
    "changed_files",
    "surfaces"
  ],
  "title": "ChangeImpactMap",
  "type": "object"
}
