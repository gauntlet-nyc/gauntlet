# Copy to .env.local (never commit). These are placeholders, NOT valid secrets.
GAUNTLET_ENV=local
GAUNTLET_LOG_LEVEL=INFO
GAUNTLET_ALLOWED_TARGET_IDS=cartwheel-fixture
GAUNTLET_ARTIFACT_DIR=./artifacts
GAUNTLET_MAX_CONCURRENT_RUNS=2
GAUNTLET_MAX_ACTIONS_PER_ATTACK=50
GAUNTLET_MAX_RUN_SECONDS=900
GAUNTLET_MAX_REPLAY_ATTEMPTS=3
RUN_LIVE_INTEGRATIONS=0

# Model via AWS Bedrock; prefer AWS_PROFILE or runtime IAM role.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=REPLACE_WITH_AVAILABLE_MODEL_ID
AWS_PROFILE=REPLACE_WITH_LOCAL_PROFILE_IF_USED

# Daytona sandbox control plane (no sandbox process receives these keys)
DAYTONA_API_KEY=REPLACE_ME
DAYTONA_API_URL=
DAYTONA_TARGET=REPLACE_WITH_APPROVED_REGION
# Base/head snapshot registration is passed separately via --registration.

# Anchor Browser
ANCHOR_API_KEY=REPLACE_ME
# Operator-managed proxy with the approved synthetic-target egress policy.
ANCHOR_PROXY_SERVER=
ANCHOR_PROXY_USERNAME=
ANCHOR_PROXY_PASSWORD=

# Arize AX / OpenInference
ARIZE_API_KEY=REPLACE_ME
ARIZE_SPACE_ID=REPLACE_ME
ARIZE_PROJECT_NAME=gauntlet-unified

# SurrealDB core (local or hosted)
SURREAL_URL=ws://127.0.0.1:8001
SURREAL_NS=gauntlet
SURREAL_DB=dev
SURREAL_USER=root
SURREAL_PASS=REPLACE_ME

# SurrealDB Agent Memory is a SEPARATE context service
SURREAL_MEMORY_ENDPOINT=REPLACE_WITH_CONTEXT_ENDPOINT
SURREAL_MEMORY_CONTEXT=gauntlet-dev
SURREAL_MEMORY_API_KEY=REPLACE_ME

# Synthetic target (NEVER real payment or customer details)
CARTWHEEL_WEB_URL=http://localhost:3000
CARTWHEEL_API_URL=http://localhost:4000
CARTWHEEL_DATABASE_URL=postgresql://gauntlet:REPLACE_ME@localhost:5432/cartwheel
CARTWHEEL_DB_PASSWORD=REPLACE_ME
NEXT_PUBLIC_GAUNTLET_API_URL=http://localhost:8000

# Optional ElevenLabs voice test/briefing only
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# Optional GitHub App (future)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
